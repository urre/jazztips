---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import optimizeImage from "../utils/optimizeImage";
import RecordLayout from "@components/record/RecordLayout.astro";
import RecordCover from "@components/record/RecordCover.astro";
import RecordInfo from "@components/record/RecordInfo.astro";

interface Frontmatter {
  title: string;
  description: string;
  artist: string;
  label?: string;
  image?: string;
  year?: string;
  pubDate?: string;
}

// Use Astro.glob() to fetch all posts, and then sort them by date.
const posts = await Astro.glob<Frontmatter>("./!(about.md|search.md)*.md");

const sortedPosts = posts
  .map((post) => ({
    ...post,
    pubDate: post.frontmatter.pubDate
      ? new Date(post.frontmatter.pubDate).valueOf()
      : 0,
  }))
  .sort((post1, post2) => post2.pubDate - post1.pubDate)
  .slice(0, 1);

const postsMore = (await Astro.glob("./!(about.md|search.md)*.md"))
  .sort(
    (a, b) =>
      new Date(b.frontmatter.pubDate).valueOf() -
      new Date(a.frontmatter.pubDate).valueOf()
  )
  .slice(1, 6);

export interface Props {
  content: {
    title: string;
    description: string;
    pubDate?: string;
    updatedDate?: string;
    image?: string;
  };
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section>
        <h3>Latest record</h3>

        {
          sortedPosts.map(
            ({ frontmatter: { title, image, artist, year, label }, url }) => (
              <RecordLayout>
                {image && (
                  <RecordCover
                    src={`${optimizeImage(image)}`}
                    alt={`${artist} - ${title}`}
                  />
                )}
                <RecordInfo
                  artist={artist}
                  title={title}
                  label={label}
                  year={year}
                  url={url}
                />
              </RecordLayout>
            )
          )
        }
        <h3>Recommended lately</h3>
        <ul>
          {
            postsMore.map((post: any) => (
              <li>
                <a href={post.url}>
                  {post.frontmatter.image && (
                    <figure class="record-cover">
                      <img
                        width={560}
                        height={560}
                        src={`${optimizeImage(post.frontmatter.image)}`}
                        alt={post.frontmatter.title}
                        loading="lazy"
                      />
                      <span />
                    </figure>
                  )}

                  <h3>{post.frontmatter.title}</h3>
                </a>
              </li>
            ))
          }
        </ul>
        <nav>
          <a class="button" href="/1"> Archives</a>
        </nav>
      </section>
    </main>
    <Footer />
  </body>
</html>
