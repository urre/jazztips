---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import optimizeImage from "../utils/optimizeImage";

interface Frontmatter {
  title: string;
  description: string;
  artist: string;
  label?: string;
  image?: string;
  year?: string;
  pubDate?: string;
}

// Use Astro.glob() to fetch all posts, and then sort them by date.
const posts = await Astro.glob<Frontmatter>("./!(about.md|search.md)*.md");

const sortedPosts = posts
  .sort((post1, post2) => {
    const pubDate1 = post1.frontmatter.pubDate
      ? new Date(post1.frontmatter.pubDate).valueOf()
      : 0;
    const pubDate2 = post2.frontmatter.pubDate
      ? new Date(post2.frontmatter.pubDate).valueOf()
      : 0;
    return pubDate2 - pubDate1;
  })
  .slice(0, 1);

const postsMore = (await Astro.glob("./!(about.md|search.md)*.md"))
  .sort(
    (a, b) =>
      new Date(b.frontmatter.pubDate).valueOf() -
      new Date(a.frontmatter.pubDate).valueOf()
  )
  .slice(1, 6);

export interface Props {
  content: {
    title: string;
    description: string;
    pubDate?: string;
    updatedDate?: string;
    image?: string;
  };
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section>
        <h3>Latest record</h3>

        {
          sortedPosts.map(
            ({ frontmatter: { title, image, artist, year, label }, url }) => (
              <div class="record-layout">
                {image && (
                  <figure class="record-cover">
                    <img
                      width={560}
                      height={560}
                      src={`${optimizeImage(image)}`}
                      alt={`${artist} - ${title}`}
                      loading="lazy"
                    />
                    <span />
                  </figure>
                )}
                <div class="record-info">
                  <h1 class="title">
                    {artist}
                    <br />
                    <span>{title}</span>
                  </h1>
                  <h2>
                    {label} – {year}
                  </h2>
                  <ul class="tags">
                    <a href={url} class="button">
                      Explore record
                    </a>
                  </ul>
                </div>
              </div>
            )
          )
        }
        <h3>Recommended lately</h3>
        <ul>
          {
            postsMore.map((post: any) => (
              <li>
                <a href={post.url}>
                  {post.frontmatter.image && (
                    <figure class="record-cover">
                      <img
                        width={560}
                        height={560}
                        src={`${optimizeImage(post.frontmatter.image)}`}
                        alt={post.frontmatter.title}
                        loading="lazy"
                      />
                      <span />
                    </figure>
                  )}

                  <h3>{post.frontmatter.title}</h3>
                </a>
              </li>
            ))
          }
        </ul>
        <nav>
          <a class="button" href="/1"> Archives</a>
        </nav>
      </section>
    </main>
    <Footer />
  </body>
</html>
