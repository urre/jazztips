---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import optimizeImage from "../utils/optimizeImage";

// Use Astro.glob() to fetch all posts, and then sort them by date.
const posts = (await Astro.glob("./!(about.md|search.md)*.md"))
  .sort(
    (a, b) =>
      new Date(b.frontmatter.pubDate).valueOf() -
      new Date(a.frontmatter.pubDate).valueOf()
  )
  .slice(0, 1);

export interface Props {
  content: {
    title: string;
    description: string;
    pubDate?: string;
    updatedDate?: string;
    image?: string;
    spotify?: string;
    tidal?: string;
    apple?: string;
    credits?: Credit[];
    name: string;
    instrument: string;
    artist?: string;
    ogimage?: string;
    year?: string;
    label?: string;
    buy?: string;
    buyat?: string;
    tags?: Array<string>;
  };
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section>
        {
          posts.map((post: any) => (
            <div class="record-layout">
              {post.frontmatter.image && (
                <figure class="record-cover">
                  <img
                    width={560}
                    height={560}
                    src={`${optimizeImage(post.frontmatter.image)}`}
                    alt={`${post.frontmatter.artist} - ${post.frontmatter.title}`}
                    loading="lazy"
                  />
                  <span />
                </figure>
              )}
              <div class="record-info">
                <h1 class="title">
                  {post.frontmatter.artist}
                  <br />
                  <span>“</span>
                  {post.frontmatter.title}
                  <span>”</span>
                </h1>
                <h2>
                  {post.frontmatter.label} –{post.frontmatter.year}
                </h2>
                <ul class="tags">
                  <a href={post.url} class="button">
                    Explore record
                  </a>
                </ul>
              </div>
            </div>
          ))
        }
      </section>
    </main>
    <Footer />
  </body>
</html>
