---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import optimizeImage from "../utils/optimizeImage";
import RecordLayout from "@components/record/RecordLayout.astro";
import RecordCover from "@components/record/RecordCover.astro";
import RecordInfo from "@components/record/RecordInfo.astro";
import Button from "@components/Button.astro";

interface Frontmatter {
  title: string;
  description: string;
  artist: string;
  label?: string;
  image?: string;
  year?: string;
  pubDate?: string;
}

const posts = await Astro.glob<Frontmatter>("./!(about.md|search.md)*.md");

const sortedPosts = posts
  .map((post) => ({
    ...post,
    pubDate: post.frontmatter.pubDate
      ? new Date(post.frontmatter.pubDate).valueOf()
      : 0,
  }))
  .sort((post1, post2) => post2.pubDate - post1.pubDate);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section>
        <h2>Latest record</h2>

        {
          sortedPosts
            .slice(0, 1)
            .map(
              ({ frontmatter: { title, image, artist, year, label }, url }) => (
                <RecordLayout>
                  {image && (
                    <RecordCover
                      pulled={true}
                      src={`${optimizeImage(image)}`}
                      alt={`${artist} - ${title}`}
                    />
                  )}
                  <RecordInfo
                    artist={artist}
                    title={title}
                    label={label}
                    year={year}
                    url={url}
                  />
                </RecordLayout>
              )
            )
        }
        <h2>Recommended lately</h2>
        <ul>
          {
            sortedPosts
              .slice(1, 6)
              .map(({ frontmatter: { title, artist, image }, url }) => (
                <li>
                  <a href={url}>
                    {image && (
                      <RecordCover
                        src={`${optimizeImage(image)}`}
                        alt={`${artist} - ${title}`}
                      />
                    )}

                    <h3>{title}</h3>
                  </a>
                </li>
              ))
          }
        </ul>
        <nav>
          <Button href="/1">Archives</Button>
        </nav>
      </section>
    </main>
    <Footer />
  </body>
</html>
