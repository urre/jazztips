---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section>
        <h1>About Jazztips</h1>

        <img
          src="https://res.cloudinary.com/urre/image/upload/v1534260522/urre_dpsi17.jpg"
          alt="A photo of Urban Sandén"
          loading="lazy"
          role="presentation"
          style="border-radius: 50%"
        />
        <p>
          This is a passion project by Urban Sandén. I started Jazztips february
          of 2015.
        </p>
        <p>
          Get in touch: <a href="mailto:hej@urre.me">hej@urre.me</a>
        </p>
      </section>
    </main>
    <Footer />
  </body>
</html>
