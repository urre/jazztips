---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import { getCollection } from "astro:content";

const records = await getCollection("records", ({ data }) => !data.draft);
const startYear = 2010;
const years = new Date().getFullYear() - startYear;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={`About — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="about">
        <img
          class="portrait"
          src="https://res.cloudinary.com/urre/image/upload/w_320,h_320,c_fill,g_face/v1534260522/urre_dpsi17.jpg"
          alt="Urban Sandén"
          width="160"
          height="160"
        />

        <h1>About Jazztips</h1>

        <p class="intro">
          Hi, I'm Urban Sandén. I started Jazztips in February {startYear}.
        </p>

        <dl class="stats">
          <div>
            <dt>Records</dt>
            <dd>{records.length}</dd>
          </div>
          <div>
            <dt>Years</dt>
            <dd>{years}</dd>
          </div>
        </dl>

        <ul class="links plain-list">
          <li>
            <a href="mailto:hej@urre.me">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="m3 7 9 6 9-6"></path>
              </svg>
              hej@urre.me
            </a>
          </li>
          <li>
            <a href="https://x.com/urre" target="_blank" rel="noopener me">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.33l4.37 5.77L17.75 3Zm-1.08 16.17h1.7L7.4 4.74H5.58l11.09 14.43Z"></path>
              </svg>
              @urre
            </a>
          </li>
          <li>
            <a href="https://urre.me" target="_blank" rel="noopener me">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path>
              </svg>
              urre.me
            </a>
          </li>
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .about {
    max-width: 36rem;
    margin: 2vh auto 0;
    padding: clamp(1.5rem, 5vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--grey-subtle);
    border-radius: calc(var(--border-radius) * 1.5);
  }

  .portrait {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    border: 0;
    object-fit: cover;
    box-shadow: var(--ring-offset) 0 0 0 4px, var(--profile) 0 0 0 6px;
    margin-bottom: 1.5rem;
  }

  h1 {
    margin: 0 auto;
  }

  .intro {
    margin: 1rem 0 0;
    max-width: 40ch;
    text-wrap: balance;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
    width: 100%;
    margin: 2rem 0;
    padding: 1.25rem 0;
    border-block: 1px solid var(--grey-subtle);
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
  }

  .stats dd {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2rem);
    line-height: 1;
    color: var(--profile);
  }

  .stats dt {
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--grey);
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 2rem;
    border: 1px solid var(--border);
    background: var(--surface);
    transition: box-shadow 150ms, border-color 150ms;
  }

  .links a:hover,
  .links a:focus-visible {
    outline: none;
    box-shadow: var(--ring-offset) 0px 0px 0px 2px, var(--profile) 0px 0px 0px 4px;
  }

  .links svg {
    width: 16px;
    height: 16px;
  }
</style>
