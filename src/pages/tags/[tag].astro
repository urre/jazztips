---
import RecordCover from "@components/record/RecordCover.astro";
import BaseHead from "@components/BaseHead.astro";
import Header from "@components/Header.astro";
import optimizeImage from "@utils/optimizeImage";
import { getCollection } from "astro:content";
import { mergeTags, tagKey } from "@utils/tags";

export async function getStaticPaths() {
  const allPosts = await getCollection("records", ({ data }) => import.meta.env.DEV || !data.draft);

  // Every spelling keeps its own URL, and all of them list the records
  // tagged with any spelling ("Hard Bop", "hard-bop", "hardbop")
  return mergeTags(allPosts.map((post) => post.data.tags)).flatMap(({ key, label, variants }) => {
    const filteredPosts = allPosts.filter((post) =>
      post.data.tags?.some((postTag: string) => tagKey(postTag) === key)
    );

    return variants.map((tag) => ({
      params: { tag },
      props: { posts: filteredPosts, label },
    }));
  });
}

const { posts, label } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={`${label}`} description="Tag" />
  </head>

  <body>
    <Header />
    <main>
      <h1>Tagged <em>{label}</em></h1>
      <ul class="record-grid">
        {
          posts.map((record) => (
            <li>
              <a href={`/${record.id}`}>
                {record.data.image && (
                  <RecordCover
                    src={`${optimizeImage(record.data.image)}`}
                    artist={record.data.artist}
                    title={record.data.title}
                  />
                )}

                <h3>
                  {record.data.artist}
                  <br /> {record.data.title}
                </h3>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
