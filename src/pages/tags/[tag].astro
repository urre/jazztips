---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import optimizeImage from "../../utils/optimizeImage";

export async function getStaticPaths() {
  const allPosts = await Astro.glob("../!(about.md|search.md)*.md");

  const uniqueTags = [
    ...new Set(allPosts.map((post) => post.frontmatter.tags).flat()),
  ];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts.filter((post) =>
      post.frontmatter.tags.includes(tag)
    );

    console.log(filteredPosts.length);

    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;

export interface Props {
  post: string;
}
---

<html lang="en">
  <head>
    <BaseHead title={`${tag}`} description="Tag" />
  </head>

  <body>
    <Header />
    <main>
      <h1>Records tagged with - <span>“</span>{tag}<span>”</span></h1>
      <ul>
        {
          posts.map(
            (post: {
              url: string | URL | null | undefined;
              frontmatter: {
                image: string | null | undefined;
                title: string;
              };
            }) => (
              <li>
                <a href={post.url}>
                  {post.frontmatter.image && (
                    <figure class="record-cover">
                      <img
                        width={560}
                        height={560}
                        src={`${optimizeImage(post.frontmatter.image)}`}
                        alt={post.frontmatter.title}
                        loading="lazy"
                      />
                      <span />
                    </figure>
                  )}
                  <h3>{post.frontmatter.title}</h3>
                </a>
              </li>
            )
          )
        }
      </ul>
    </main>
  </body>
</html>
