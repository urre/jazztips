---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";

import { getCollection } from "astro:content";

// Get all posts from the collection
const records = await getCollection("records", ({ data }) => import.meta.env.DEV || !data.draft);

// Extract tags from post data instead of frontmatter
const tags = [...new Set(records.map((record) => record.data.tags).flat())];
const uniqueTagCount = tags.length;

const pageTitle = "Taggregister";
---

<html lang="sv">
  <head>
    <BaseHead title={pageTitle} description="Taggar" />
  </head>

  <body>
    <Header />
    <main>
      <h1>Utforska efter taggar</h1>
      <p>Just nu <em>{uniqueTagCount}</em> taggar</p>
      <ul class="tags">
        {
          tags
            .sort((tag1: string, tag2: string) => tag1.localeCompare(tag2))
            .map((tag) => (
              <li>
                <a rel="tag" class="button" href={`/tags/${tag}`}>
                  {tag}
                </a>
              </li>
            ))
        }
      </ul>
    </main>
  </body>
</html>
