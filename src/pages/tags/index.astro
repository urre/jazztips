---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";

const allPosts = await Astro.glob("../!(about.md|search.md)*.md");

const tags = [...new Set(allPosts.map((post) => post.frontmatter.tags).flat())];
const uniqueTagCount = [
  ...new Set(allPosts.map((post) => post.frontmatter.tags).flat()),
].length;

const pageTitle = "Tag Index";
---

<html lang="en">
  <head>
    <BaseHead title={pageTitle} description="Tags" />
  </head>

  <body>
    <Header />
    <main>
      <h1>View content by Tags</h1>
      <p>Currently <em>{uniqueTagCount}</em> tags</p>
      <ul class="tags">
        {
          tags
            .sort((tag1: string, tag2: string) => tag1.localeCompare(tag2))
            .map((tag) => (
              <li>
                <a rel="tag" class="button" href={`/tags/${tag}`}>
                  {tag}
                </a>
              </li>
            ))
        }
      </ul>
    </main>
  </body>
</html>
