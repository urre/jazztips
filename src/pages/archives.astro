---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import { getCollection } from "astro:content";
import optimizeImage from "@utils/optimizeImage";
import { normalizeLabel } from "@utils/labels";
import "../styles/dashboard.css";

const records = (
  await getCollection("records", ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const thisYear = new Date().getFullYear();
const firstYear = Math.min(...records.map((r) => r.data.pubDate.getFullYear()));
const years = Array.from({ length: thisYear - firstYear + 1 }, (_, i) => thisYear - i);

const byYear = new Map(years.map((year) => [year, [] as typeof records]));
records.forEach((r) => byYear.get(r.data.pubDate.getFullYear())?.push(r));
const yearsWithRecords = years.filter((year) => byYear.get(year)!.length > 0);

// Stats
const perYear = years.map((year) => ({ year, count: byYear.get(year)!.length })).reverse();
const busiest = perYear.reduce((max, y) => (y.count > max.count ? y : max), perYear[0]);
const maxPerYear = busiest.count || 1;
const countThisYear = byYear.get(thisYear)?.length ?? 0;
const countLastYear = byYear.get(thisYear - 1)?.length ?? 0;
const labels = new Set(records.map((r) => normalizeLabel(r.data.label)?.toLowerCase()).filter(Boolean));
const latest = records[0];

// Tags differ only in case ("Jazz" / "jazz"); count them together and link the
// most used spelling
const tagCounts = new Map<string, { count: number; spellings: Map<string, number> }>();
records.forEach((r) =>
  r.data.tags.forEach((tag) => {
    const entry = tagCounts.get(tag.toLowerCase()) ?? { count: 0, spellings: new Map() };
    entry.count++;
    entry.spellings.set(tag, (entry.spellings.get(tag) ?? 0) + 1);
    tagCounts.set(tag.toLowerCase(), entry);
  })
);
const topTags = [...tagCounts.values()]
  .sort((a, b) => b.count - a.count)
  .slice(0, 10)
  .map(({ count, spellings }) => ({
    count,
    tag: [...spellings].sort((a, b) => b[1] - a[1])[0][0],
  }));
const maxTag = topTags[0]?.count || 1;

const dayMonth = (date: Date) => date.toLocaleDateString("en-GB", { day: "numeric", month: "short" });
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={`Archive — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="page-header">
        <h1>Archive</h1>
        <p>{records.length} jazz recommendations since {firstYear}.</p>
      </section>

      <section class="stats-grid" aria-label="Overview">
        <div class="stat-card">
          <span class="stat-number">{records.length}</span>
          <span class="stat-label">Records</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">{thisYear - firstYear + 1}</span>
          <span class="stat-label">Years, since {firstYear}</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">{countThisYear}</span>
          <span class="stat-label">
            Added in {thisYear}
            {countLastYear > 0 && ` · ${countThisYear >= countLastYear ? "+" : "−"}${Math.abs(countThisYear - countLastYear)} vs ${thisYear - 1}`}
          </span>
        </div>
        <div class="stat-card">
          <span class="stat-number">{labels.size}</span>
          <span class="stat-label">Record labels</span>
        </div>
        {
          latest && (
            <a class="stat-card stat-card--highlight latest" href={`/${latest.id}`}>
              <img src={optimizeImage(latest.data.image)} alt="" width="48" height="48" />
              <span class="stat-label">
                Latest: <strong>{latest.data.artist} – {latest.data.title}</strong>
              </span>
            </a>
          )
        }
      </section>

      <section class="charts archive-charts" aria-label="Charts">
        <figure class="panel chart">
          <figcaption>
            <h2>Added per year</h2>
            <p class="chart-caption">Busiest: {busiest.year} with {busiest.count} records · click a year to jump</p>
          </figcaption>
          <div class="columns" role="img" aria-label={`Records added per year: ${perYear.map((y) => `${y.year} ${y.count}`).join(", ")}`}>
            {
              perYear.map((y) => (
                <a class="column" href={`#year-${y.year}`} data-tip={`${y.year}: ${y.count} records`}>
                  <span class="column-value">{y.count === busiest.count ? y.count : ""}</span>
                  <span class="column-bar" style={`height: ${(y.count / maxPerYear) * 100}%`} />
                  <span class="column-label">{`’${String(y.year).slice(2)}`}</span>
                </a>
              ))
            }
          </div>
        </figure>

        <figure class="panel chart">
          <figcaption>
            <h2>Top tags</h2>
            <p class="chart-caption">{tagCounts.size} tags in total</p>
          </figcaption>
          <ol class="bar-chart plain-list">
            {
              topTags.map(({ tag, count }) => (
                <li>
                  <a class="bar-row" href={`/tags/${tag}`}>
                    <span class="bar-label">{tag}</span>
                    <span class="bar-track">
                      <span class="bar-fill" style={`width: ${(count / maxTag) * 100}%`} />
                    </span>
                    <span class="bar-value">{count}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </figure>

      </section>

      <section class="archive" id="archive">
        <div class="toolbar">
          <input
            type="search"
            id="archive-search"
            placeholder="Filter by artist, title or label…"
            autocomplete="off"
            aria-label="Filter records"
          />
        </div>
        <nav class="chips" aria-label="Jump to year">
          {
            yearsWithRecords.map((year) => (
              <a class="chip" href={`#year-${year}`} data-year-chip={year}>
                {year} <span class="chip-count">{byYear.get(year)!.length}</span>
              </a>
            ))
          }
        </nav>
        <p id="result-count" class="result-count" aria-live="polite"></p>

        {
          yearsWithRecords.map((year) => (
            <section class="year" id={`year-${year}`} data-year={year}>
              <h2 class="year-heading">
                {year} <span class="pill year-count">{byYear.get(year)!.length}</span>
              </h2>
              <ul class="records plain-list">
                {byYear.get(year)!.map((record) => (
                  <li
                    data-search={[record.data.artist, record.data.title, record.data.label]
                      .filter(Boolean)
                      .join(" ")
                      .toLowerCase()}
                  >
                    <a href={`/${record.id}`} class="record">
                      <img
                        src={optimizeImage(record.data.image)}
                        alt=""
                        width="56"
                        height="56"
                        loading="lazy"
                        decoding="async"
                      />
                      <span class="record-text">
                        <span class="record-artist">{record.data.artist}</span>
                        <span class="record-title">{record.data.title}</span>
                        <span class="record-meta">
                          {[record.data.label, record.data.year].filter(Boolean).join(" · ")}
                        </span>
                      </span>
                      <time class="record-date" datetime={record.data.pubDate.toISOString()}>
                        {dayMonth(record.data.pubDate)}
                      </time>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
        <p id="no-results" class="no-results" hidden>No records found.</p>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .latest {
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
  }

  .latest img {
    width: 48px;
    height: 48px;
    flex: 0 0 auto;
    object-fit: cover;
    border: 0;
    border-radius: 6px;
  }

  .latest .stat-label {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .archive-charts {
      grid-template-columns: 3fr 2fr;
    }
  }

  .archive-charts {
    margin-bottom: 3rem;
  }

  .column {
    cursor: pointer;
  }

  .chips {
    margin-bottom: 0.5rem;
  }

  a.chip {
    text-decoration: none;
  }

  .year {
    margin-top: 2.5rem;
    scroll-margin-top: 1rem;
  }

  .year-heading {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--grey-subtle);
  }

  .records {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 0.5rem;
  }

  .record {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.5rem;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--grey-subtle);
    transition: border-color 150ms, box-shadow 150ms;
  }

  .record:hover {
    border-color: var(--profile);
  }

  .record:focus-visible {
    outline: none;
    box-shadow: var(--ring-offset) 0px 0px 0px 2px, var(--profile) 0px 0px 0px 4px;
  }

  .record img {
    width: 56px;
    height: 56px;
    flex: 0 0 auto;
    object-fit: cover;
    border: 0;
    border-radius: 6px;
    background: var(--grey-subtle);
  }

  .record-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
    line-height: 1.3;
  }

  .record-artist,
  .record-title,
  .record-meta {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .record-artist {
    font-size: 0.8rem;
    color: var(--grey);
  }

  .record-title {
    font-size: 0.95rem;
  }

  .record-meta {
    font-size: 0.75rem;
    color: var(--grey);
  }

  .record-date {
    align-self: flex-start;
    font-size: 0.7rem;
    color: var(--grey);
    white-space: nowrap;
  }

  .year[hidden],
  .records li[hidden],
  .chip[hidden] {
    display: none;
  }
</style>

<script>
  import "../scripts/chart-tooltip";

  const search = document.getElementById("archive-search") as HTMLInputElement;
  const resultCount = document.getElementById("result-count") as HTMLElement;
  const noResults = document.getElementById("no-results") as HTMLElement;
  const yearSections = document.querySelectorAll<HTMLElement>(".year");

  search.addEventListener("input", () => {
    const query = search.value.trim().toLowerCase();
    let total = 0;

    yearSections.forEach((section) => {
      let count = 0;
      section.querySelectorAll<HTMLElement>("li[data-search]").forEach((item) => {
        const match = !query || item.dataset.search!.includes(query);
        item.hidden = !match;
        if (match) count++;
      });
      section.hidden = count === 0;
      section.querySelector(".year-count")!.textContent = String(count);
      const chip = document.querySelector<HTMLElement>(`[data-year-chip="${section.dataset.year}"]`);
      if (chip) {
        chip.hidden = count === 0;
        chip.querySelector(".chip-count")!.textContent = String(count);
      }
      total += count;
    });

    resultCount.textContent = query ? `${total} record${total === 1 ? "" : "s"} found` : "";
    noResults.hidden = total > 0;
  });
</script>
