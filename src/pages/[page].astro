---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagination from "@components/Pagination.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import optimizeImage from "../utils/optimizeImage";
import RecordCover from "@components/record/RecordCover.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection("records", ({ data }) => import.meta.env.DEV || !data.draft);

  const sortedPosts = allPosts
    .map((post) => ({
      ...post,
      pubDate: post.data.pubDate ? new Date(post.data.pubDate).valueOf() : 0,
    }))
    .sort((a, b) => b.pubDate - a.pubDate);

  return paginate(sortedPosts, { pageSize: 30 });
}

const { page } = Astro.props;
---

<!DOCTYPE html>
<html lang="sv">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section>
        <h1>Skivor</h1>
        <p>Sida {page.currentPage} av {page.lastPage}</p>
        <Pagination prev={page.url.prev} next={page.url.next} />

        <ul>
          {
            page.data.map((record) => (
              <li>
                <a href={`/${record.id}`}>
                  {record.data.image && (
                    <RecordCover
                      src={`${optimizeImage(record.data.image)}`}
                      alt={`${record.data.artist} - ${record.data.title}`}
                    />
                  )}

                  <h3>
                    {record.data.artist}
                    <br /> {record.data.title}
                  </h3>
                </a>
              </li>
            ))
          }
        </ul>

        <Pagination prev={page.url.prev} next={page.url.next} />
      </section>
    </main>
    <Footer />
  </body>
</html>
