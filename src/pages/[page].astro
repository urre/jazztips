---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagination from "@components/Pagination.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import optimizeImage from "../utils/optimizeImage";
import RecordCover from "@components/record/RecordCover.astro";

interface Frontmatter {
  title: string;
  description: string;
  artist: string;
  label?: string;
  image?: string;
  year?: string;
  pubDate?: string;
}

export async function getStaticPaths({ paginate }: any) {
  const allPosts = (
    await Astro.glob<Frontmatter>("./!(about.md|search.md)*.md")
  )
    .map((post) => ({
      ...post,
      pubDate: post.frontmatter.pubDate
        ? new Date(post.frontmatter.pubDate).valueOf()
        : 0,
    }))
    .sort((post1, post2) => post2.pubDate - post1.pubDate);

  return paginate(allPosts, { pageSize: 30 });
}

const { page } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section>
        <h2>Archive</h2>
        <Pagination prev={page.url.prev} next={page.url.next} />

        <ul>
          {
            page.data.map(
              ({
                frontmatter: { title, image, artist },
                url,
              }: {
                frontmatter: Frontmatter;
                url: string;
              }) => (
                <li>
                  <a href={url}>
                    {image && (
                      <RecordCover
                        src={`${optimizeImage(image)}`}
                        alt={`${artist} - ${title}`}
                      />
                    )}

                    <h3>{title}</h3>
                  </a>
                </li>
              )
            )
          }
        </ul>

        <Pagination prev={page.url.prev} next={page.url.next} />
      </section>
    </main>
    <Footer />
  </body>
</html>
