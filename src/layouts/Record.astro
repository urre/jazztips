---
import BaseHead from "@components/BaseHead.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Musicians from "@components/record/Musicians.astro";
import Embeds from "@components/record/embeds/Embeds.astro";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import RecordCover from "@components/record/RecordCover.astro";
import RecordInfo from "@components/record/RecordInfo.astro";
import Tags from "@components/record/Tags.astro";
import Explore from "@components/record/Explore.astro";
import RecordCopyButton from "@components/record/RecordCopyButton.astro";
import AlsoAppearsOn from "../components/AlsoAppearsOn.astro";
import Analytics from "@vercel/analytics/astro";

export interface Musician {
  name: string;
  instrument: string;
}

export interface Tag {
  tag: string;
}

export interface Color {
  color: string;
}

export interface Props {
  title: string;
  description: string;
  pubDate?: string;
  updatedDate?: string;
  image?: ImageMetadata;
  spotify?: string;
  tidal?: string;
  apple?: string;
  qobuz?: string;
  credits?: Musician;
  tags?: Tag;
  name: string;
  instrument: string;
  artist?: string;
  ogimage?: string;
  year?: string;
  label?: string;
  buy?: string;
  buyat?: string;
  src?: string;
  pulled?: boolean;
  alt?: string;
  colors?: Color;
}

const {
  title,
  artist,
  ogimage,
  spotify,
  apple,
  tidal,
  qobuz,
  credits,
  description,
  updatedDate,
  year,
  label,
  image,
  buy,
  buyat,
  tags,
} = Astro.props;

const tidalLink = tidal
  ? `https://tidal.com/browse/album/${tidal}`
  : `https://listen.tidal.com/search?q=${encodeURIComponent(
      `${artist} ${title}`
    )}`;

const tidalId = typeof tidal === "string" ? tidal.replace(/\D/g, "") : tidal;

const appleLink = `https://music.apple.com/us/search?term=${encodeURIComponent(
  `${artist} ${title}`
)}`;

const postId = Astro.url.pathname.replace(/^\/|\/$/g, "");

// Small cover for the Qobuz card, and a JPEG for link previews since not
// every service that reads og:image understands AVIF or WebP
const qobuzCover = image && (await getImage({ src: image, width: 240, format: "webp" })).src;
const shareImage =
  ogimage ?? (image && (await getImage({ src: image, width: 1000, format: "jpg", quality: 82 })).src);
---

<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <BaseHead
      title={`${artist} - ${title}`}
      description={description ?? `Album review for ${artist} - ${title}`}
      image={shareImage}
    />
  </head>

  <Header />

  <main>
    <article class="record">
      <div class="record-hero">
        {
          image && (
            <RecordCover
              pulled={true}
              image={image}
              artist={artist}
              title={title}
              abovefold={true}
              size="large"
            />
          )
        }

        <RecordInfo artist={artist} title={title} label={label} year={year}>
          {
            updatedDate && (
              <div class="updated">
                Last updated on <time>{updatedDate}</time>
              </div>
            )
          }
        </RecordInfo>
      </div>

      <div class="record-body">
        {credits && <Musicians musicians={credits} />}

        <Embeds
          tidal={tidal}
          spotify={spotify}
          apple={apple}
          qobuz={qobuz}
          artist={artist}
          title={title}
          cover={qobuzCover}
        />
        <Tags tags={tags} />

        <Explore
          tidal={tidal}
          tidalLink={tidalLink}
          tidalId={tidalId}
          artist={artist}
          qobuz={qobuz}
          title={title}
          buyat={buyat}
          buy={buy}
          spotify={spotify}
          appleLink={appleLink}
          apple={apple}
        />

        {artist && <AlsoAppearsOn musicians={credits} postId={postId} />}
        <RecordCopyButton
          artist={artist}
          title={title}
          label={label}
          year={year}
          credits={credits}
          description={description}
        />
      </div>
    </article>
  </main>
  <Footer />
  <Analytics />
</html>

<style>
  /* One centred column: cover and title on a row, everything else below */
  .record {
    max-width: 1100px;
    margin-inline: auto;
  }

  .record-hero {
    display: grid;
    justify-items: center;
    gap: calc(var(--gap) * 0.75);
    text-align: center;
    margin-bottom: calc(var(--gap) * 1.5);
  }

  .record-hero :global(h1) {
    margin-inline: auto;
  }

  .updated {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--grey);
  }

  @media (min-width: 768px) {
    .record-hero {
      grid-template-columns: min(420px, 42vw) minmax(0, 1fr);
      align-items: center;
      justify-items: start;
      /* Room for the vinyl peeking out from behind the cover */
      column-gap: calc(var(--fluid-gap) * 5);
      text-align: left;
    }

    .record-hero :global(h1) {
      margin-inline: 0;
    }

    /* Same cover size at every width from here, the record cover component
       otherwise switches between sizes made for the old side column */
    .record .record-hero :global(.record-cover:has(img.image-lg)) {
      width: 100%;
      max-width: 420px;
      aspect-ratio: 1 / 1;
    }

    .record .record-hero :global(.record-cover:has(img.image-lg) span) {
      opacity: 1;
    }
  }

  .record-body {
    display: grid;
    gap: calc(var(--gap) * 0.5);
  }

  .record-body > :global(fieldset) {
    margin: 0;
  }
</style>
