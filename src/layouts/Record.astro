---
import BaseHead from "@components/BaseHead.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Musicians from "@components/record/Musicians.astro";
import Embeds from "@components/record/embeds/Embeds.astro";
import optimizeImage from "../utils/optimizeImage";
import RecordCover from "@components/record/RecordCover.astro";
import RecordLayout from "@components/record/RecordLayout.astro";
import RecordInfo from "@components/record/RecordInfo.astro";
import Tags from "@components/record/Tags.astro";
import Explore from "@components/record/Explore.astro";
import RecordCopyButton from "@components/record/RecordCopyButton.astro";

export interface Musician {
  name: string;
  instrument: string;
}

export interface Tag {
  tag: string;
}

export interface Color {
  color: string;
}

export interface Props {
  title: string;
  description: string;
  pubDate?: string;
  updatedDate?: string;
  image?: string;
  spotify?: string;
  tidal?: string;
  apple?: string;
  qobuz?: string;
  credits?: Musician;
  tags?: Tag;
  name: string;
  instrument: string;
  artist?: string;
  ogimage?: string;
  year?: string;
  label?: string;
  buy?: string;
  buyat?: string;
  src?: string;
  pulled?: boolean;
  alt?: string;
  colors?: Color;
}

const {
  title,
  artist,
  ogimage,
  spotify,
  apple,
  tidal,
  qobuz,
  credits,
  description,
  updatedDate,
  year,
  label,
  image,
  buy,
  buyat,
  tags,
} = Astro.props;

console.log(title);

const tidalLink = tidal
  ? `https://tidal.com/browse/album/${tidal}`
  : `https://listen.tidal.com/search?q=${encodeURIComponent(
      `${artist} ${title}`
    )}`;

const tidalId = typeof tidal === "string" ? tidal.replace(/\D/g, "") : tidal;

const appleLink = `https://music.apple.com/us/search?term=${encodeURIComponent(
  `${artist} ${title}`
)}`;
---

<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <BaseHead
      title={`${artist} - ${title}`}
      description={description ?? `Album review for ${artist} - ${title}`}
      image={ogimage}
    />
  </head>

  <Header />

  <main>
    <article>
      <RecordLayout>
        {
          image && (
            <RecordCover
              pulled={true}
              src={`${optimizeImage(image)}`}
              artist={artist}
              title={title}
              abovefold={true}
              size="large"
            />
          )
        }

        <RecordInfo artist={artist} title={title} label={label} year={year}>
          {
            updatedDate && (
              <div>
                Last updated on <time>{updatedDate}</time>
              </div>
            )
          }

          {credits && <Musicians musicians={credits} />}

          <Embeds
            tidal={tidal}
            spotify={spotify}
            apple={apple}
            qobuz={qobuz}
            artist={artist}
            title={title}
            cover={optimizeImage(image)}
          />
          <Tags tags={tags} />

          <Explore
            tidal={tidal}
            tidalLink={tidalLink}
            tidalId={tidalId}
            artist={artist}
            qobuz={qobuz}
            title={title}
            buyat={buyat}
            buy={buy}
            spotify={spotify}
            appleLink={appleLink}
            apple={apple}
          />

          <RecordCopyButton
            artist={artist}
            title={title}
            label={label}
            year={year}
            credits={credits}
          />
        </RecordInfo>
      </RecordLayout>
    </article>
  </main>
  <Footer />
</html>
