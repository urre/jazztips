---
export interface Props {
  image?: string;
  artist?: string;
  title?: string;
  src?: string;
  alt?: string;
  pulled?: boolean;
  abovefold?: boolean;
  size?: string;
}

const { src, artist, title, pulled, abovefold, size } = Astro.props;
---

<style>
  .record-cover {
    position: relative;
    max-width: 240px;
    transition: transform 800ms ease-in-out;
    box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;
  }

  @media (min-width: 1400px) {
    .record-cover:has(img.image-lg) {
      max-width: 500px;
    }
  }

  @media (min-width: 1200px) {
    .record-cover {
      aspect-ratio: 1 / 1;
    }
  }

  .record-cover img {
    position: relative;
    aspect-ratio: 1 / 1;
    z-index: 1;
    background-color: white;
    object-fit: cover;
  }

  .record-cover:hover span {
    transform: translateX(20%);
  }

  .record-cover span {
    position: absolute;
    border-radius: 50%;
    background-color: #000;
    z-index: 0;
    top: 0;
    left: 0;
    transition: transform 800ms cubic-bezier(0.175, 0.885, 0.32, 1.275);

    opacity: 0;
    transform: translateX(10px) translateY(0.5rem);
    height: 90%;
    width: 90%;
    max-width: 800px;
    max-height: 800px;
    aspect-ratio: 1 / 1;
    background-image: -webkit-radial-gradient(
        rgba(0, 0, 0, 1) 0,
        rgba(0, 0, 0, 1) 1%,
        rgba(206, 70, 38, 1) 2%,
        rgba(206, 70, 38, 1) 21%,
        rgba(206, 70, 38, 1) 22%,
        rgba(206, 70, 38, 1) 23%,
        rgba(206, 70, 38, 0.5) 24%,
        rgba(255, 255, 255, 0) 25%,
        rgba(255, 255, 255, 0.1) 54%,
        rgba(255, 255, 255, 0) 55%,
        rgba(255, 255, 255, 0) 60%,
        rgba(255, 255, 255, 0.1) 61%,
        rgba(255, 255, 255, 0) 62%,
        rgba(255, 255, 255, 0.1) 63%,
        rgba(255, 255, 255, 0) 64%,
        rgba(255, 255, 255, 0.1) 65%,
        rgba(255, 255, 255, 0) 66%
      ),
      -webkit-linear-gradient(45deg, #000 0%, #000 30%, rgba(47, 47, 47, 1) 50%, #000
            70%, #000 100%);
    background-image: radial-gradient(
        rgba(0, 0, 0, 1) 0,
        rgba(0, 0, 0, 1) 1%,
        rgba(206, 70, 38, 1) 2%,
        rgba(206, 70, 38, 1) 21%,
        rgba(206, 70, 38, 1) 22%,
        rgba(206, 70, 38, 1) 23%,
        rgba(206, 70, 38, 0.5) 24%,
        rgba(255, 255, 255, 0) 25%,
        rgba(255, 255, 255, 0) 60%,
        rgba(255, 255, 255, 0.1) 61%,
        rgba(255, 255, 255, 0) 62%,
        rgba(255, 255, 255, 0.1) 63%,
        rgba(255, 255, 255, 0) 64%,
        rgba(255, 255, 255, 0.1) 65%,
        rgba(255, 255, 255, 0) 66%
      ),
      linear-gradient(
        45deg,
        #000 0%,
        #000 30%,
        rgba(47, 47, 47, 1) 50%,
        #000 70%,
        #000 100%
      );
  }

  .record-cover-pulled span {
    transform: translateX(20%);
  }

  .record-cover-pulled:hover span {
    transform: translateX(30%);
  }

  @media (min-width: 1200px) {
    .record-cover span {
      opacity: 1;
    }
  }
</style>

<figure class={`record-cover ${pulled ? "record-cover-pulled" : ""} `}>
  {
    abovefold ? (
      <img
        width={`${size === "large" ? "800" : "560"}`}
        height={`${size === "large" ? "800" : "560"}`}
        src={src}
        alt={`${artist} - ${title}`}
        class={`${size === "large" ? "image-lg" : ""}`}
      />
    ) : (
      <img
        width={560}
        height={560}
        src={src}
        alt={`${artist} - ${title}`}
        loading="lazy"
        class={`${size === "large" ? "image-lg" : ""}`}
      />
    )
  }
  <span></span>
</figure>
