---
import Button from "@components/Button.astro";

const { tags } = Astro.props;
---

{
  tags ? (
    <fieldset>
      <legend>Tags</legend>
      <ul>
        {tags
          .sort((tag1: string, tag2: string) => tag1.localeCompare(tag2))
          .map((tag: string) => (
            <li>
              <Button href={`/tags/${tag}`}>{tag}</Button>
            </li>
          ))}
      </ul>
    </fieldset>
  ) : null
}

<style>
  ul {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    margin: 0;
  }
</style>
