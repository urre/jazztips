---
import Button from "@components/Button.astro";

const { tags } = Astro.props;
---

<fieldset>
  <legend>Tags</legend>

  <ul>
    {
      tags
        .sort((tag1: string, tag2: string) => tag1.localeCompare(tag2))
        .map((tag: string) => (
          <li>
            <Button href={`/tags/${tag}`}>{tag}</Button>
          </li>
        ))
    }
  </ul>
</fieldset>

<style>
  ul {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }
</style>
