---
export interface UsersListProps {
  musicians: Musician[];
}

export interface Musician {
  name: string;
  instrument: string;
}

const { musicians } = Astro.props;
---

<h2>Musicians</h2>
{
  musicians.map((musician: Musician) => (
    <dl>
      <dt>
        <a
          href={`https://www.discogs.com/search/?q=${musician.name}&type=artist`}
          rel="tag"
          title={`Explore ${musician.name} on Discogs`}
        >
          {musician.name}
        </a>
      </dt>
      <dd>{musician.instrument}</dd>
    </dl>
  ))
}
