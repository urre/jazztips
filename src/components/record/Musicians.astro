---
export interface MusicianListProps {
  musicians: Musician[];
}

export interface Musician {
  name: string;
  instrument: string;
}

const { musicians } = Astro.props;
---

<fieldset>
  <legend>Musicians</legend>
  <ul class="musicians">
    {
      musicians.map((musician: Musician) => (
        <li class="musician">
          <div class="name">
            <span>{musician.name}</span>

            <div class="name-meta">
              <a href={`${Astro.request.url}/?query=${musician.name}`}>
                <em>Search Jazztips →</em>
              </a>

              <a
                href={`https://www.discogs.com/search/?q=${musician.name}&type=artist`}
                title={`Explore ${musician.name} on Discogs`}
                target="_blank"
              >
                <em>Search Discogs →</em>
              </a>
            </div>
          </div>
          <div class="instrument">{musician.instrument}</div>
        </li>
      ))
    }
  </ul>
</fieldset>

<style>
  .musicians {
    --gap: 2rem;

    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  /* As many columns as fit: two or three on tablets, four on desktop */
  @media (min-width: 768px) {
    .musicians {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 1.5rem var(--gap);
    }
  }

  .name {
    flex-basis: 30%;
    display: inline-flex;
    gap: 0rem;
    flex-direction: column;
  }

  .name span {
    font-size: 1.5rem;
  }

  .name-meta {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .name a {
    font-size: smaller;
    text-decoration: underline;
    text-underline-offset: 4px;
    font-size: 0.85rem;
  }

  .link a {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
</style>
