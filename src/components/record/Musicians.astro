---
export interface MusicianListProps {
  musicians: Musician[];
}

export interface Musician {
  name: string;
  instrument: string;
}

const { musicians } = Astro.props;
---

<fieldset>
  <legend>Musicians</legend>
  <ul class="musicians">
    {
      musicians.map((musician: Musician) => (
        <li class="musician">
          <div class="name">
            {musician.name}

            <a
              href={`https://www.discogs.com/search/?q=${musician.name}&type=artist`}
              title={`Explore ${musician.name} on Discogs`}
              target="_blank"
            >
              <em>Discogs →</em>
            </a>
          </div>
          <div class="instrument">{musician.instrument}</div>
        </li>
      ))
    }
  </ul>
</fieldset>

<style>
  .musicians {
    --gap: 2rem;

    display: unset;
  }
  @media (min-width: 1024px) {
    .musicians {
      display: flex;
      flex-wrap: wrap;
      gap: var(--gap);
    }
  }

  @media (min-width: 1024px) {
    .musician {
      flex: 0 0 calc(35% - var(--gap));
    }
  }

  .name {
    flex-basis: 30%;
    display: inline-flex;
    gap: 2rem;
    align-items: center;
    font-size: 1.5rem;
  }

  .name a {
    font-size: smaller;
    text-decoration: underline;
    text-underline-offset: 4px;
    font-size: 0.85rem;
  }

  /* .instrument {
    flex-basis: 20%;
  } */

  .link a {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
</style>
