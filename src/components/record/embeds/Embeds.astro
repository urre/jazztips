---
import Tidal from "@components/record/Tidal.astro";
import Spotify from "@components/record/Spotify.astro";
import Apple from "@components/record/Apple.astro";
import HiResIcon from "@components/icons/HiResIcon.astro";
export interface Props {
  spotify?: string;
  tidal?: string;
  apple?: string;
}

const { spotify, apple, tidal } = Astro.props;
---

<fieldset>
  <legend>Listen</legend>

  <div class="embeds">
    {
      tidal && (
        <div>
          <h3>
            TIDAL <HiResIcon />
          </h3>
          <Tidal tidal={tidal} />
        </div>
      )
    }
    {
      spotify && (
        <div>
          <h3>Spotify</h3>
          <Spotify spotify={spotify} />
        </div>
      )
    }
    {
      apple && (
        <div>
          <h3>
            Apple Music <HiResIcon />
          </h3>
          <Apple apple={apple} />
        </div>
      )
    }
  </div>
</fieldset>

<style>
  .embeds {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--fluid-gap) * 1);
  }
</style>
