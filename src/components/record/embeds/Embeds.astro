---
import Tidal from "@components/record/Tidal.astro";
import Spotify from "@components/record/Spotify.astro";
import Apple from "@components/record/Apple.astro";
import Qobuz from "@components/record/Qobuz.astro";
import HiResIcon from "@components/icons/HiResIcon.astro";
export interface Props {
  spotify?: string;
  qobuz?: string;
  tidal?: string;
  apple?: string;
  cover?: string;
  artist?: string;
  title?: string;
}

const { spotify, apple, tidal, qobuz, cover, artist, title } = Astro.props;
---

<fieldset>
  <legend>Listen</legend>

  <div class="embeds">
    {
      tidal && (
        <div>
          <h3>
            TIDAL <HiResIcon />
          </h3>
          <Tidal tidal={tidal} />
        </div>
      )
    }
    {
      apple && (
        <div>
          <h3>
            Apple Music <HiResIcon />
          </h3>
          <Apple apple={apple} />
        </div>
      )
    }
    {
      spotify && (
        <div>
          <h3>Spotify</h3>
          <Spotify spotify={spotify} />
        </div>
      )
    }

    {
      qobuz && (
        <div>
          <h3>
            Qobuz <HiResIcon />
          </h3>
          <Qobuz link={qobuz} artist={artist} title={title} cover={cover} />
        </div>
      )
    }
  </div>
</fieldset>

<style>
  .embeds {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--fluid-gap) * 1.5);
  }

  .embeds div {
    flex: 0 0 25%;
  }
</style>
