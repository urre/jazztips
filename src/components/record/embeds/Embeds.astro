---
import Tidal from "@components/record/Tidal.astro";
import Spotify from "@components/record/Spotify.astro";
import Apple from "@components/record/Apple.astro";
import Qobuz from "@components/record/Qobuz.astro";
import HiResIcon from "@components/icons/HiResIcon.astro";
export interface Props {
  spotify?: string;
  qobuz?: string;
  tidal?: string;
  apple?: string;
  cover?: string;
  artist?: string;
  title?: string;
}

const { spotify, apple, tidal, qobuz, cover, artist, title } = Astro.props;
const count = [tidal, apple, spotify, qobuz].filter(Boolean).length;
---

<fieldset>
  <legend>Lyssna</legend>

  <div class:list={["embeds", { "two-col": count > 3 }]}>
    {
      tidal && (
        <div>
          <h3>TIDAL</h3>
          <Tidal tidal={tidal} />
        </div>
      )
    }
    {
      apple && (
        <div>
          <h3>Apple Music</h3>
          <Apple apple={apple} />
        </div>
      )
    }
    {
      spotify && (
        <div>
          <h3>Spotify</h3>
          <Spotify spotify={spotify} />
        </div>
      )
    }

    {
      qobuz && (
        <div>
          <h3>Qobuz</h3>
          <Qobuz link={qobuz} artist={artist} title={title} cover={cover} />
        </div>
      )
    }
  </div>
</fieldset>

<style>
  /* Keep the players packed next to each other instead of stretched
     across equal-width columns, which left big gaps between them. */
  .embeds {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.75rem 1rem;
  }

  .embeds > div {
    flex: 0 1 auto;
    min-width: 0;
    max-width: 100%;
  }

  .embeds h3 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
    color: var(--grey);
  }

  /* Roughly the same footprint as the other players so they pack tightly */
  .embeds :global(.applemusic) {
    --apple-width: 320px;
  }

  .embeds :global(iframe) {
    max-width: 100%;
  }

  /* Spotify's player is shorter than the others and brings no card of its
     own, so give it a white frame that adds up to the same height */
  .embeds :global(iframe[src*="spotify"]) {
    box-sizing: content-box;
    height: 84px;
    /* more room above/below to centre the player, less on the sides so the
       player itself does not get squeezed */
    padding: 18px 12px;
    /* the padding sits outside the content box, so leave room for it */
    max-width: calc(100% - 24px);
    background-color: #ffffff;
    border-radius: 12px;
    box-shadow: rgba(0, 0, 0, 0.05) 0px 6px 24px 0px,
      rgba(0, 0, 0, 0.08) 0px 0px 0px 1px;
  }
</style>
