---
export interface Props {
  embedCode?: string;
  class?: string;
}

const { embedCode, classname } = Astro.props;
---

<style>
  .embeds {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-top: 4rem;
  }

  iframe {
    border: 0;
    height: 120px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-items: center;
    background-color: black;
  }
</style>

<iframe
  class={classname}
  src={embedCode}
  allowtransparency="true"
  frame-border="0"
  allow="encrypted-media"></iframe>
