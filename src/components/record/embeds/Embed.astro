---
export interface Props {
  embedCode?: string;
  class?: string;
  classname?: string;
}

const { embedCode, classname } = Astro.props;
---

<style>
  iframe {
    border: 0;
    height: 120px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-items: center;
  }

  .applemusic {
    --apple-width: 300px;

    left: 0;
    width: var(--apple-width);
    height: 120px;
    position: relative;
    overflow: clip;
    box-shadow: rgba(0, 0, 0, 0.05) 0px 6px 24px 0px,
      rgba(0, 0, 0, 0.08) 0px 0px 0px 1px;
    border-radius: 6px;
  }

  @media (min-width: 768px) {
    .applemusic {
      --apple-width: 360px;
    }
  }
</style>

{
  embedCode?.includes("music.apple") ? (
    <div class="applemusic">
      <iframe
        src={embedCode}
        style="top: 0; left: 0; width: 100%; height: 100%; position: absolute; border: 0; overflow: hidden; background-color: transparent;"
        allowfullscreen
        allow="encrypted-media; fullscreen; clipboard-write;"
      />
    </div>
  ) : (
    <iframe
      class={classname}
      src={embedCode}
      allowtransparency="true"
      frame-border="0"
      allow="encrypted-media"
    />
  )
}
