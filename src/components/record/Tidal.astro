---
import Embed from "./embeds/Embed.astro";

export interface Props {
  tidal: string;
}

const { tidal } = Astro.props;

const tidalLink =
  typeof tidal === "string" && tidal.includes("https")
    ? tidal
        .replace("tidal.com", "embed.tidal.com")
        .replace("browse/album", "albums")
        .split("?")[0]
    : `https://embed.tidal.com/albums/${tidal}`;
---

<Embed embedCode={`${tidalLink}`} />
