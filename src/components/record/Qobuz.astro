---
export interface Props {
  link?: string;
  title?: string;
  artist?: string;
  cover?: string;
}

const { link, cover, title, artist } = Astro.props;
---

<a class="qobuz" href={link}>
  <img src={cover} alt={title} />
  <div>
    <span>{artist}</span>
    <span>{title}</span>
  </div>
</a>

<style>
  .qobuz {
    width: 310px;
    height: 125px;
    box-shadow: rgba(0, 0, 0, 0.05) 0px 6px 24px 0px,
      rgba(0, 0, 0, 0.08) 0px 0px 0px 1px;
    border-radius: 6px;
    border: 0;
    height: 120px;
    border-radius: 8px;
    display: flex;
    gap: 1rem;
    align-items: center;
    background-color: white;
  }

  .qobuz img {
    width: 120px;
    height: 120px;
    border-radius: 6px;
  }

  .qobuz div {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;

    span:nth-child(2) {
      color: grey;
    }
  }
</style>
