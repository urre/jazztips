---
export interface Props {
  link?: string;
  title?: string;
  artist?: string;
  cover?: string;
}

const { link, cover, title, artist } = Astro.props;
---

<a class="qobuz" href={link}>
  <img src={cover} alt={title} />
  <div>
    <span>{artist}</span>
    <span>{title}</span>
  </div>
</a>

<style>
  .qobuz {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: min(100%, 340px);
    height: 120px;
    padding-right: 1rem;
    overflow: hidden;
    border: 0;
    border-radius: 8px;
    box-shadow: rgba(0, 0, 0, 0.05) 0px 6px 24px 0px,
      var(--border) 0px 0px 0px 1px;
    background-color: var(--surface);
  }

  .qobuz img {
    flex-shrink: 0;
    width: 120px;
    height: 120px;
    border-radius: 6px;
    object-fit: cover;
  }

  .qobuz div {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    line-height: 1.3;

    span {
      overflow: hidden;
      text-overflow: ellipsis;
    }

    span:first-child {
      white-space: nowrap;
    }

    /* Long album titles get two lines, then an ellipsis */
    span:nth-child(2) {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      color: var(--grey);
    }
  }
</style>
