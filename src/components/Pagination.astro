---
import Button from "./Button.astro";

export interface Props {
  prev?: string;
  next?: string;
}

// Use Astro's direct access to props
const { prev, next } = Astro.props;
---

<style>
  nav {
    display: flex; /* Flexbox is more versatile for responsive layouts */
    justify-content: flex-end;
    align-items: center;
    gap: 1rem;
    padding: 2rem 0;
    list-style: none;
  }

  /* Responsive improvements for smaller screens */
</style>

<nav aria-label="Pagination navigation">
  {
    prev && (
      <Button href={prev} aria-label="Go to previous page">
        Previous
      </Button>
    )
  }
  {
    next && (
      <Button href={next} aria-label="Go to next page">
        Next
      </Button>
    )
  }
</nav>
