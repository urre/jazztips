---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../config";
import SearchBar from "./SearchBar.astro";
---

<style>
  header {
    padding-top: calc(var(--gap) * 1.5);
    padding-bottom: calc(var(--gap) * 1.5);
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }

  header nav {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }

  header h1 {
    margin: 0;
    all: unset;
  }

  header h1 a {
    display: flex;

    align-items: center;
    gap: 0.5rem;
  }

  header .dot {
    border-radius: 50%;
    display: inline-block;
    height: 18px;
    width: 18px;
    background-color: var(--profile);
  }

  header h1 {
    font-size: 1.2rem;
  }
</style>

<header>
  <h1>
    <a href="/">
      <span class="dot"></span>
      {SITE_TITLE}
    </a>
  </h1>
  <nav>
    <HeaderLink rel="tag" href="/1">Archives</HeaderLink>
    <HeaderLink rel="tag" href="/tags">Tags</HeaderLink>
    <SearchBar />
  </nav>
</header>
