---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../config";
import SearchBar from "./SearchBar.astro";
---

<style>
  header {
    padding-top: calc(var(--gap) * 1.5);
    padding-bottom: calc(var(--gap) * 1.5);
    width: 100%;
    gap: 1em;
    display: flex;
    justify-content: space-between;
    flex-direction: column-reverse;
  }

  @media (min-width: 768px) {
    header {
      flex-direction: row;
    }
  }

  @media (min-width: 768px) {
    header nav {
      display: flex;
      gap: 1em;
      justify-content: space-between;
      align-items: center;
    }
  }

  header h1 {
    margin: 0;
    all: unset;
  }

  header h1 a {
    display: flex;

    align-items: center;
    gap: 1.5rem;
  }

  header .dot {
    border-radius: 50%;
    display: inline-block;
    height: 18px;
    width: 18px;
    background-color: var(--profile);
  }

  header h1 {
    font-size: 1.5rem;
  }

  header img {
    border-radius: 50%;
    width: 96px;
    height: 96px;
  }
</style>

<header>
  <h1>
    <a href="/">
      <img
        src="https://res.cloudinary.com/urre/image/upload/v1727800699/aqw2sns0cg4bndqpimmy.jpg"
        alt=""
      />
      {SITE_TITLE}
    </a>
  </h1>
  <nav>
    <HeaderLink rel="tag" href="/1">Archives</HeaderLink>
    <HeaderLink rel="tag" href="/tags">Tags</HeaderLink>
    <HeaderLink rel="tag" href="/about">About</HeaderLink>
    <SearchBar />
  </nav>
</header>
