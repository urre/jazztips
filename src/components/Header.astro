---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../config";
import SearchBar from "./SearchBar.astro";
---

<header>
  <h1>
    <a href="/">
      <img
        src="https://res.cloudinary.com/urre/image/upload/v1727800699/aqw2sns0cg4bndqpimmy.jpg"
        alt="Jazztips icon"
      />
      {SITE_TITLE}
    </a>
  </h1>
  <nav>
    <HeaderLink rel="tag" href="/1">Records</HeaderLink>
    <HeaderLink rel="tag" href="/archives">Archive</HeaderLink>
    <HeaderLink rel="tag" href="/musicians">Musicians</HeaderLink>
    <HeaderLink rel="tag" href="/tags">Tags</HeaderLink>
    <HeaderLink rel="tag" href="/about">About</HeaderLink>
    <SearchBar />
  </nav>
</header>

<style>
  header {
    width: 100%;
    display: flex;
    gap: clamp(1.15rem, 5vw, 2rem);
    flex-direction: column;
    padding-top: calc(var(--gap));
    padding-bottom: 2rem;
  }

  @media (min-width: 768px) {
    header {
      padding-bottom: calc(var(--gap) * 1.5);
      padding-top: calc(var(--gap) * 1.5);
      flex-direction: row;
    }
  }

  header nav {
    justify-content: space-between;
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--gap) / 2);
  }

  header h1 {
    margin: 0;
    all: unset;
  }

  header h1 a {
    display: flex;

    align-items: center;
    gap: 1.5rem;
  }

  header .dot {
    border-radius: 50%;
    display: inline-block;
    height: 18px;
    width: 18px;
    background-color: var(--profile);
  }

  header h1 {
    font-size: clamp(1.15rem, 5vw, 2rem);
  }

  header img {
    border-radius: 50%;
    width: 36px;
    height: 36px;
  }

  @media (min-width: 768px) {
    header img {
      width: 96px;
      height: 96px;
    }
  }
</style>
