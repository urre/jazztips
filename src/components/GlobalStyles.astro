<style is:global>
  :root {
    --profile: #008965;
    --profile-dark: #f78c79;
    --bg-color: #f8f8f8;
    --fluid-gap: clamp(0.5rem, 3vw, 1.5rem);
    --gap: 2rem;
  }

  /* Box sizing rules */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  /* Remove default margin */
  body,
  figure,
  blockquote,
  dl,
  dd {
    margin: 0;
  }

  /* Remove list styles on ul, ol elements with a list role, which suggests default styling will be removed */
  ul[role="list"],
  ol[role="list"] {
    list-style: none;
  }

  /* Set core root defaults */
  html:focus-within {
    scroll-behavior: smooth;
  }

  /* A elements that don't have a class get default styles */
  a:not([class]) {
    text-decoration-skip-ink: auto;
  }

  /* Make images easier to work with */
  img,
  picture {
    max-width: 100%;
    display: block;
    border: 2px solid white;
  }

  /* Inherit fonts for inputs and buttons */
  input,
  button,
  textarea,
  select {
    font: inherit;
  }

  html:focus-within {
    scroll-behavior: auto;
  }

  img {
    max-width: 100%;
    display: block;
    height: auto;
    border-radius: 8px;
  }

  svg {
    max-width: 100%;
    width: 18px;
    height: 18px;
  }

  @font-face {
    font-family: Spectral-Light;
    src: url("/fonts/Spectral-Light.woff2") format("woff2");
    font-weight: normal;
    font-style: normal;
    font-display: block;
  }

  body {
    min-height: 100vh;
    text-rendering: optimizeSpeed;
    line-height: 1.5;
    -webkit-text-size-adjust: 100%;
    font-size: 100%;
    line-height: 1.75;
    max-width: 130em;
    margin: 0 auto;
    padding-left: calc(var(--fluid-gap) * 1.25);
    padding-right: calc(var(--fluid-gap) * 1.25);
    color: #111;
    font-family: "Spectral-Light", "Times New Roman", Times, serif;
    background-color: var(--bg-color);
  }

  html {
    background-color: var(--bg-color);
    text-size-adjust: 100%;
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  }

  ul {
    list-style: none;
    padding: 0;
    margin-top: calc(var(--gap));
    display: grid;
    gap: calc(var(--gap) * 1.5);
    grid-template-columns: repeat(
      auto-fit,
      minmax(calc(var(--fluid-gap) * 12), 1fr)
    );
  }

  .page-about ul {
    display: initial;
    list-style: unset;
    list-style-position: inside;
    font-size: clamp(0.75rem, 3vw, 1.2rem);
  }

  p {
    font-size: clamp(0.75rem, 3vw, 1.2rem);
  }

  footer {
    margin-top: 10vh;
    padding-top: 2vh;
    padding-bottom: 2vh;
  }

  .tags {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 1rem;
  }

  :is(h1, h2, h3, h4, h5, h6) {
    line-height: 1.2;
    margin-top: calc(var(--gap) * 1);
    margin-bottom: calc(var(--gap) * 0.5);
    padding: 0;
    font-weight: initial;
  }

  a {
    text-decoration: none;
    color: unset;
  }

  p a {
    color: var(--profile);
    text-decoration: underline;
  }

  h1 {
    font-size: clamp(2.2rem, 3.6vw, 4rem);
    letter-spacing: -0.01em;
    max-width: 36ch;
  }

  h2 {
    font-size: clamp(1.5rem, 5vw, 2rem);
    letter-spacing: 0.01em;
  }

  p {
    letter-spacing: 0.045em;
  }

  [rel="tag"] {
    transition: border-color 150ms;
    padding: 0.25rem 0.75rem;
    border-radius: 2rem;
    transition: box-shadow 150ms;
  }

  [rel="tag"]:hover,
  [rel="tag"]:focus {
    box-shadow: rgb(255 255 255) 0px 0px 0px 2px, var(--profile) 0px 0px 0px 4px;
  }

  [rel="tag"]:active {
    transform: translateY(0.15rem);
  }

  .search {
    position: relative;
  }

  ul.search-list {
    display: unset;
    position: absolute;
    background-color: white;
    padding: 0.5rem;
    border-radius: 6px;
    right: 0;
    top: 0.25rem;
    z-index: 100;
    list-style: none;
    width: 300px;
    box-shadow: rgba(100, 100, 111, 0.2) 0px 7px 29px 0px;
  }

  .search-list li:hover {
    background-color: #f6f6f6;
  }

  input[type="search"] {
    padding: 0.25rem 1rem;
    border-radius: 1rem;
    border: none;
  }

  .search-list figure + div {
    max-width: 300px;
    overflow-wrap: break-word;
  }
</style>
