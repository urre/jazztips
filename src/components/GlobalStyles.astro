<style is:global>
  /* Follows the system unless the theme switcher has set data-theme */
  :root {
    color-scheme: light dark;
  }

  :root[data-theme="light"] {
    color-scheme: light;
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
  }

  :root {
    --profile: light-dark(#008965, #3cc49a);
    --profile-dark: #f78c79;
    --bg-color: light-dark(#f8f8f8, #121314);
    --surface: light-dark(#ffffff, #1c1d1f);
    --surface-hover: light-dark(#f6f6f6, #26272a);
    --text: light-dark(#111111, #e9e7e3);
    --text-soft: light-dark(rgba(0, 0, 0, 0.85), rgba(255, 255, 255, 0.85));
    --border: light-dark(rgba(0, 0, 0, 0.1), rgba(255, 255, 255, 0.12));
    --border-soft: light-dark(rgba(0, 0, 0, 0.07), rgba(255, 255, 255, 0.08));
    --shadow: light-dark(rgba(100, 100, 111, 0.2), rgba(0, 0, 0, 0.5));
    --ring-offset: light-dark(#ffffff, #121314);
    --fluid-gap: clamp(0.5rem, 3vw, 1.5rem);
    --gap: 2rem;
    --grey: light-dark(#777777, #9a9a9a);
    --grey-light: light-dark(#c8c8c8, #4a4b4e);
    --grey-subtle: light-dark(#eeeeee, #2a2b2e);
    --border-radius: 16px;
  }

  /* Box sizing rules */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  /* Remove default margin */
  body,
  figure,
  blockquote,
  dl,
  dd {
    margin: 0;
  }

  /* Remove list styles on ul, ol elements with a list role, which suggests default styling will be removed */
  ul[role="list"],
  ol[role="list"] {
    list-style: none;
  }

  /* Set core root defaults */
  html:focus-within {
    scroll-behavior: smooth;
  }

  /* A elements that don't have a class get default styles */
  a:not([class]) {
    text-decoration-skip-ink: auto;
  }

  /* Make images easier to work with */
  img,
  picture {
    max-width: 100%;
    display: block;
    border: 2px solid var(--surface);
  }

  /* Inherit fonts for inputs and buttons */
  input,
  button,
  textarea,
  select {
    font: inherit;
  }

  html:focus-within {
    scroll-behavior: auto;
  }

  img {
    max-width: 100%;
    display: block;
    height: auto;
    border-radius: 8px;
  }

  svg {
    max-width: 100%;
    width: 18px;
    height: 18px;
  }

  @font-face {
    font-family: Spectral-Light;
    src: url("/fonts/Spectral-Light.woff2") format("woff2");
    font-weight: normal;
    font-style: normal;
    font-display: block;
  }

  body {
    min-height: 100vh;
    text-rendering: optimizeSpeed;
    line-height: 1.5;
    -webkit-text-size-adjust: 100%;
    font-size: clamp(1rem, 2vmin, 1.25rem);
    line-height: 1.75;
    max-width: 130em;
    margin: 0 auto;
    padding-left: calc(var(--fluid-gap) * 1.25);
    padding-right: calc(var(--fluid-gap) * 1.25);
    color: var(--text);
    font-family: "Spectral-Light", "Times New Roman", Times, serif;
    background-color: var(--bg-color);
  }

  html {
    background-color: var(--bg-color);
    text-size-adjust: 100%;
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  }

  ul:not(.plain-list, .record-grid) {
    list-style: none;
    padding: 0;
    margin-top: calc(var(--gap));
    gap: var(--gap);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
  }

  @media (min-width: 768px) {
    ul:not(.plain-list, .record-grid) {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    }
  }

  /* Grids of record covers. The column count comes from a minimum cell
     width, and the covers fill their cells so rows line up without gaps:
     2 on phones, 3-4 on tablets, 5-6 on laptops, 7+ on big screens */
  .record-grid {
    --cell: 140px;

    list-style: none;
    padding: 0;
    margin: var(--gap) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--cell)), 1fr));
    gap: clamp(1.25rem, 3vw, 2.25rem) clamp(0.75rem, 2vw, 1.5rem);
  }

  @media (min-width: 600px) {
    .record-grid {
      --cell: 170px;
    }
  }

  @media (min-width: 1024px) {
    .record-grid {
      --cell: 200px;
    }
  }

  @media (min-width: 1600px) {
    .record-grid {
      --cell: 220px;
    }
  }

  .record-grid .record-cover.record-cover {
    max-width: none;
  }

  .record-grid h3 {
    margin: 0.6rem 0 0;
    font-size: clamp(0.95rem, 1.1vw, 1.1rem);
    line-height: 1.35;
  }

  ul:is(.regular-list) {
    display: initial;
  }

  p {
    font-size: clamp(0.75rem, 3vw, 1.2rem);
  }

  footer {
    margin-top: 10vh;
    padding-top: 2vh;
    padding-bottom: 2vh;
  }

  .tags {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 1rem;
  }

  :is(h1, h2, h3, h4, h5, h6) {
    line-height: 1.2;
    /* margin-top: calc(var(--gap) * 1);
    margin-bottom: calc(var(--gap) * 0.5); */
    padding: 0;
    font-weight: initial;
  }

  a {
    text-decoration: none;
    color: unset;
  }

  p a {
    color: var(--profile);
    text-decoration: underline;
  }

  h1 {
    font-size: clamp(1.5rem, 3.6vw, 4rem);
    letter-spacing: -0.01em;
    max-width: 36ch;
  }

  h2 {
    font-size: clamp(1.15rem, 5vw, 2rem);
    letter-spacing: 0.01em;
  }

  p {
    letter-spacing: 0.045em;
  }

  [rel="tag"] {
    transition: border-color 150ms;
    padding: 0.25rem 0.75rem;
    border-radius: 2rem;
    transition: box-shadow 0.1s;
  }

  [rel="tag"]:hover {
    box-shadow: var(--ring-offset) 0px 0px 0px 2px, var(--profile) 0px 0px 0px 4px;
  }

  [rel="tag"]:focus-visible {
    box-shadow: var(--ring-offset) 0px 0px 0px 2px, var(--profile) 0px 0px 0px 4px;
  }
  .search {
    position: relative;
  }

  ul:is(.search-list) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    position: absolute;
    background-color: var(--surface);
    padding: 1rem;
    border-radius: 6px;
    left: 0;
    top: 0.25rem;
    z-index: 100;
    list-style: none;
    box-shadow: var(--shadow) 0px 7px 29px 0px;
    width: 100%;
    min-width: 600px;
    max-height: 600px;
    overflow-y: auto;

    @media (max-width: 480px) {
      min-width: unset;
      width: 100%;
    }
  }

  .search-list li:hover {
    background-color: var(--surface-hover);
  }

  input[type="search"] {
    padding: 0.25rem 1rem;
    border-radius: 1rem;
    border: none;
    background-color: var(--surface);
    color: inherit;
    box-shadow: rgba(0, 0, 0, 0.05) 0px 6px 24px 0px,
      var(--border) 0px 0px 0px 1px;
    border-radius: 6px;
    transition: all 200ms;
  }

  fieldset {
    padding: 1rem 1.5rem;
    margin-top: 2vmin;
    margin-bottom: 2vmin;
    border-radius: 16px;
    border: none;
    border: 1px solid var(--grey-light);
  }

  .pill {
    border-radius: var(--border-radius);
    color: var(--grey);
    border: 2px solid var(--grey-subtle);
    background-color: var(--grey-subtle);
    text-align: center;
    padding: 0.25rem 0.5rem;
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    vertical-align: middle;
  }
</style>
