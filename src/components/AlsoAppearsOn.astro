---
import { getCollection } from "astro:content";
import RecordCover from "./record/RecordCover.astro";
import optimizeImage from "@utils/optimizeImage";

export interface Props {
  musicians?: Array<{ name: string; instrument: string }>;
  postId?: string;
}

const { musicians, postId } = Astro.props;

// Get all records
const allRecords = await getCollection("records", ({ data }) => import.meta.env.DEV || !data.draft);

// Find records where any of our credits (by name) appear, excluding the current post
const appearsOn = musicians
  ? allRecords.filter(
      (record) =>
        record.id !== postId &&
        record.data.credits?.some((recordCredit) =>
          musicians.some((ourCredit) => ourCredit.name === recordCredit.name)
        )
    )
  : [];

// Get the specific credits that appear on each record
const appearingCredits = musicians
  ? [
      ...new Map(
        musicians
          .flatMap((ourCredit) => {
            const recordsWithCredit = appearsOn
              .filter((record) =>
                record.data.credits?.some(
                  (recordCredit) => recordCredit.name === ourCredit.name
                )
              )

              .map((record) => ({
                name: record.data.title,
                instrument: ourCredit.instrument,
                slug: record.id,
              }));

            return recordsWithCredit;
          })
          .map((record) => [record.slug, record])
      ).values(),
    ]
  : [];
---

{
  appearingCredits.length > 1 && (
    <div>
      <h2>Musicians on this records also appears on</h2>
      <ul>
        {appearingCredits.map((credit) => (
          <li>
            <a href={`/${encodeURIComponent(credit.slug)}`}>
              {appearsOn.find((record) => record.id === credit.slug)?.data
                .image && (
                <RecordCover
                  src={`${optimizeImage(
                    appearsOn.find((record) => record.id === credit.slug)?.data
                      .image ?? ""
                  )}`}
                  alt={`${credit.name}`}
                />
              )}

              <h3>
                {/* The credit name represents the album title here */}
                {credit.name}
              </h3>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
