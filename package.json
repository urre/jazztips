    "release": "git add . && git commit -m 'New record' && git push"
  },
  "dependencies": {
    "@acab/reset.css": "^0.5.3",
    "@astrojs/mdx": "^3.1.7",
    "@astrojs/react": "^3.6.2",
    "@astrojs/rss": "^4.0.7",
    "@astrojs/sitemap": "^3.1.6",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.0.0",
    "astro": "^4.15.9",
    "cal-sans": "^1.0.1",
    "fuse.js": "^7.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "prettier": "^2.8.2",
    "prettier-plugin-astro": "^0.8.0"
  }
}
