{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "title": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "label": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image": {
      "type": "string",
      "format": "uri"
    },
    "spotify": {
      "type": "string",
      "format": "uri"
    },
    "tidal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        }
      ]
    },
    "apple": {
      "type": "string",
      "format": "uri"
    },
    "qobuz": {
      "type": "string",
      "format": "uri"
    },
    "credits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "instrument": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "instrument"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "artist",
    "pubDate",
    "tags",
    "image",
    "credits"
  ]
}